Subject: [PATCH] disable all remaining vpu power domains

---
 arch/arm64/boot/dts/freescale/imx8mp-wp400.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-wp400.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-wp400.dtsi
index 215c6f1e3e27..e1badbc781b2 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-wp400.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp-wp400.dtsi
@@ -736,3 +736,15 @@ &mix_gpu_ml {
 &pgc_vpumix {
 	status = "disabled";
 };
+
+&pgc_vpu_g1 {
+	status = "disabled";
+};
+
+&pgc_vpu_g2 {
+	status = "disabled";
+};
+
+&pgc_vpu_vc8000e {
+	status = "disabled";
+};
