 .../boot/dts/freescale/imx8mp-wp400.dtsi      | 734 ++++++++++++++++++
 4 files changed, 922 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-wp400-0007.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-wp400-0010.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-wp400-0015.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-wp400.dtsi

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-wp400-0007.dts b/arch/arm64/boot/dts/freescale/imx8mp-wp400-0007.dts
new file mode 100644
index 000000000000..5d8389a46f4e
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx8mp-wp400-0007.dts
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright 2023 elrest GmbH
+ */
+
+/dts-v1/;
+
+#include "imx8mp-wp400.dtsi"
+
+/ {
+	model = "WAGO iMX8M Plus WP400 web panel";
+	compatible = "wago,imx8mp-wp400", "fsl,imx8mp";
+
+	panel_lvds: panel-lvds {
+		compatible = "panel-lvds";
+		backlight = <&backlight>;
+		data-mapping = "vesa-24";
+		width-mm = <116>;
+		height-mm = <90>;
+		status = "okay";
+
+		panel-timing {
+			clock-frequency = <41193600>;
+			hactive = <1024>;
+			vactive = <600>;
+			hback-porch = <100>;
+			hfront-porch = <170>;
+			vback-porch = <5>;
+			vfront-porch = <5>;
+			hsync-len = <50>;
+			vsync-len = <3>;
+			hsync-active = <0>;
+			vsync-active = <0>;
+			de-active    = <1>;
+		};
+
+		port {
+			panel_lvds1_in: endpoint {
+				remote-endpoint = <&lvds1_out>;
+			};
+		};
+	};
+};
+
+&ldb {
+	status = "okay";
+
+	lvds_channel0: lvds-channel@0 {
+		fsl,data-mapping = "spwg"; 
+		fsl,data-width = <24>;
+		status = "okay";
+		port@1 {
+			reg = <1>;
+			lvds1_out: endpoint {
+				remote-endpoint = <&panel_lvds1_in>;
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/freescale/imx8mp-wp400-0010.dts b/arch/arm64/boot/dts/freescale/imx8mp-wp400-0010.dts
